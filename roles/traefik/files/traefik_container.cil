(block traefik_container
    (blockinherit container)
    (blockinherit restricted_net_container)

    ;; 1. allow bind privileged ports
    (allow process process (capability (net_bind_service)))
    ;; 1a. allow bind and access port 80, and 443
    (allow process http_port_t (tcp_socket (name_bind name_connect)))
    ;; 1b. allow bind and access port 8080
    (allow process http_cache_port_t (tcp_socket (name_bind name_connect)))
    ;; 1c. allow bind and access high-numbered port 32768-60999
    (allow process ephemeral_port_t (tcp_socket (name_bind name_connect)))

    ;; 2. allow connecting to unix sockets
    (allow process user_tmp_t (sock_file (write)))
    (allow process container_runtime_t (unix_stream_socket (connectto)))
)